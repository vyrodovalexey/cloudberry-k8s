{
  "uid": "cloudberry-otel",
  "title": "Cloudberry OTEL / Telemetry",
  "tags": [
    "cloudberry",
    "otel",
    "telemetry"
  ],
  "schemaVersion": 39,
  "editable": true,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Traces",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "traces",
      "title": "Operator Spans (service.name=cloudberry-operator)",
      "description": "Explore operator traces from Tempo. Spans include Reconcile, handleMigrate, vault.*, EnsureCertificates, API '<METHOD> <path>', reconcileBackup, runFTSProbe, handleFailover, operator.certRotationCheck, exporter.collect, exporter.history.cleanup.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"cloudberry-operator\" }",
          "tableType": "traces",
          "limit": 50
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "row",
      "title": "OTEL Collector Health",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Spans Received vs Exported (rate)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_accepted_spans{instance=~\"$instance\"}[5m]))",
          "legendFormat": "received",
          "refId": "A"
        },
        {
          "expr": "sum(rate(otelcol_exporter_sent_spans{instance=~\"$instance\"}[5m]))",
          "legendFormat": "exported",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Exporter Send Failures (rate)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
