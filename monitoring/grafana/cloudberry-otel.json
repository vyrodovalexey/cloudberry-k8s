      "title": "Scrape Target Health (up by job)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (job) (up{instance!~\".*:5432\"})",
          "legendFormat": "{{job}}",
          "refId": "A"
