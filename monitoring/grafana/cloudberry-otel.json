    {
      "id": 7,
      "type": "timeseries",
      "title": "Batch Processor (send size / triggers)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_processor_batch_batch_send_size_sum{instance=~\"$instance\"}[5m]))",
          "legendFormat": "batch send size",
          "refId": "A"
        },
        {
          "expr": "sum(rate(otelcol_processor_batch_timeout_trigger_send{instance=~\"$instance\"}[5m]))",
          "legendFormat": "timeout trigger send",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(otelcol_processor_batch_batch_send_size_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "batch size p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
