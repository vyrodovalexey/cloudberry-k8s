<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Standalone HBase configuration for the openeuler/hbase test-env service.

  Mode: hbase.cluster.distributed=false — the single `hbase master start`
  process hosts Master + RegionServer + embedded ZooKeeper in one JVM
  (replaces harisekhon/hbase's five separate daemons; the previous image's
  JDK-8 daemons wedge permanently under qemu-x86_64 emulation on arm64).

  Contract with test/docker-compose/scripts/setup-hbase.sh and
  gen-hadoop-samples.sh:
    - ZooKeeper client port 2181, answering the 4lw `ruok` probe.
    - clientPortAddress MUST be 0.0.0.0: without it the embedded ZooKeeper
      binds loopback only and published-port / cross-container clients
      (healthcheck, setup scripts, PXF via the k8s ExternalName service)
      never get a reply. Verified empirically (TASK-U010, 2026-11-15).
    - 4lw whitelist re-enables `ruok` (disabled by default since ZooKeeper
      3.5; this HBase bundles ZooKeeper 3.8.6).
    - Ports 16010 (Master UI) / 16020 (RS RPC) / 16030 (RS UI) match the
      compose port map and the k8s ExternalName Service ports.
    - Data lives under /hbase-data (the compose `hbase_data` volume).
-->
<configuration>
  <property><name>hbase.cluster.distributed</name><value>false</value></property>
  <property><name>hbase.rootdir</name><value>file:///hbase-data/hbase</value></property>
  <property><name>hbase.zookeeper.property.clientPort</name><value>2181</value></property>
  <property><name>hbase.zookeeper.property.clientPortAddress</name><value>0.0.0.0</value></property>
  <property><name>hbase.zookeeper.property.4lw.commands.whitelist</name><value>ruok,stat,srvr,mntr,conf</value></property>
  <property><name>hbase.unsafe.stream.capability.enforce</name><value>false</value></property>
  <property><name>hbase.master.info.port</name><value>16010</value></property>
  <property><name>hbase.regionserver.port</name><value>16020</value></property>
  <property><name>hbase.regionserver.info.port</name><value>16030</value></property>
</configuration>
